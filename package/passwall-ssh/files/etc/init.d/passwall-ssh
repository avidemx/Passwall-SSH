#!/bin/sh /etc/rc.common

START=90
STOP=10

LOG="/tmp/etc/passwall-ssh.log"
STATE_FILE="/tmp/etc/passwall-ssh.state"
ENV_FILE="/usr/share/passwall-ssh/passwall-ssh.env"
SLOWDNS_SUPERVISOR_PID="/var/run/passwall-ssh-slowdns.pid"
LOCK="/var/run/passwall-ssh.control.lock"

acquire_lock() {
    local count=0
    while ! mkdir "$LOCK" 2>/dev/null; do
        sleep 1
        count=$((count+1))
        if [ "$count" -ge 10 ]; then
            rmdir "$LOCK" 2>/dev/null
        fi
    done
    trap 'rmdir "$LOCK" 2>/dev/null' EXIT
}

release_lock() {
    rmdir "$LOCK" 2>/dev/null
    trap - EXIT
}

write_log() {
    echo "<span color=\"#3C86AB\">[$(date '+%Y-%m-%d %H:%M:%S')] $*</span>" >> "$LOG"
}


_stop_slowdns() {
    if [ -f "$SLOWDNS_SUPERVISOR_PID" ]; then
        _slowdns_pid=$(cat "$SLOWDNS_SUPERVISOR_PID" 2>/dev/null)
        if [ -n "$_slowdns_pid" ] && kill -0 "$_slowdns_pid" 2>/dev/null; then
            kill -TERM "$_slowdns_pid" 2>/dev/null
            _slowdns_wait=0
            while kill -0 "$_slowdns_pid" 2>/dev/null && [ "$_slowdns_wait" -lt 20 ]; do
                sleep 1
                _slowdns_wait=$((_slowdns_wait + 1))
            done
            if kill -0 "$_slowdns_pid" 2>/dev/null; then
                kill -9 "$_slowdns_pid" 2>/dev/null
            fi
        fi
        rm -f "$SLOWDNS_SUPERVISOR_PID"
    fi
}

_stop() {
    _stop_slowdns
    echo "STOPPING" > "$STATE_FILE"

    # Kill Watchdog & Client scripts
    if [ -f /var/run/passwall-ssh-watchdog.pid ]; then
        kill -9 $(cat /var/run/passwall-ssh-watchdog.pid) >/dev/null 2>&1
        rm -f /var/run/passwall-ssh-watchdog.pid
    fi
    killall -9 watchdog.sh >/dev/null 2>&1
    for i in $(ps w | grep "[w]atchdog.sh" | awk '{print $1}'); do kill -9 $i >/dev/null 2>&1; done

    if [ -f /tmp/state/passwall-ssh/current_rx ]; then
        mv /tmp/state/passwall-ssh/current_rx /usr/share/passwall-ssh/last_rx
        mv /tmp/state/passwall-ssh/current_tx /usr/share/passwall-ssh/last_tx
        mv /tmp/state/passwall-ssh/current_conn /usr/share/passwall-ssh/last_conn
    fi

    # Bersihkan routing SSH lama hanya bila PID file core lama memang ada.
    # SlowDNS memakai supervisor dan routing terpisah.
    if [ -f /var/run/passwall-ssh-tun2socks.pid ] || [ -f /var/run/pw_dnsproxy.pid ]; then
        sh /usr/share/passwall-ssh/passwall-ssh.sh stop >/dev/null 2>&1
    fi

    # Kill SSH Clients, autossh, sshpass, dan nc (netcat)
    if [ -f /var/run/passwall-ssh-client.pid ]; then
        kill -9 $(cat /var/run/passwall-ssh-client.pid) >/dev/null 2>&1
        rm -f /var/run/passwall-ssh-client.pid
    fi
    killall -9 passwall-ssh-client.sh >/dev/null 2>&1
    for i in $(ps w | grep "[p]asswall-ssh-client.sh" | awk '{print $1}'); do kill -9 $i >/dev/null 2>&1; done
    
    killall -9 autossh >/dev/null 2>&1
    killall -9 sshpass >/dev/null 2>&1
    killall -9 ssh >/dev/null 2>&1
    killall -9 nc >/dev/null 2>&1

    # Kill Lua HTTP
    if [ -f /var/run/passwall-http.pid ]; then
        kill -9 $(cat /var/run/passwall-http.pid) >/dev/null 2>&1
        rm -f /var/run/passwall-http.pid
    fi
    for i in $(ps w | grep "[p]asswall-ssh-http.lua" | awk '{print $1}'); do kill -9 $i >/dev/null 2>&1; done

    # Kill Stunnel
    if [ -f /var/run/passwall-stunnel.pid ]; then
        kill -9 $(cat /var/run/passwall-stunnel.pid) >/dev/null 2>&1
        rm -f /var/run/passwall-stunnel.pid
    fi
    for i in $(ps w | grep "[s]tunnel /usr/share/passwall-ssh/stunnel.conf" | awk '{print $1}'); do kill -9 $i >/dev/null 2>&1; done
    
    echo "STOPPED" > "$STATE_FILE"
}

_start() {
    MODE=$(uci -q get passwall-ssh.main.transport_mode 2>/dev/null)
    [ -z "$MODE" ] && MODE="ssh"

    if [ "$MODE" = "slowdns" ]; then
        ENABLE=$(uci -q get passwall-ssh-slowdns.SlowDNS.enabled 2>/dev/null)
    else
        ENABLE=$(uci -q get passwall-ssh.main.enabled 2>/dev/null)
    fi

    if [ "$ENABLE" != "1" ]; then
        _stop
        return 0
    fi

    _stop

    echo "STARTING" > "$STATE_FILE"
    touch "$LOG"
    rm -f /tmp/etc/passwall-ssh.auth_failed
    rm -f /tmp/etc/passwall-ssh.kex_failed

    if [ -f /tmp/etc/passwall-ssh.is_retry ]; then
        rm -f /tmp/etc/passwall-ssh.is_retry
    else
        rm -f /tmp/etc/passwall-ssh.retry
    fi

    if [ "$MODE" = "slowdns" ]; then
        if ! sh /usr/share/passwall-ssh/passwall-ssh-slowdns-apply.sh; then
            write_log "SlowDNS configuration invalid. Check /etc/config/passwall-ssh-slowdns."
            echo "ERROR" > "$STATE_FILE"
            return 1
        fi

        /usr/share/passwall-ssh/passwall-ssh-slowdns-supervisor.sh &
        echo $! > "$SLOWDNS_SUPERVISOR_PID"
        return 0
    fi

    sh /usr/share/passwall-ssh/passwall-ssh-apply.sh || return 1

    [ -f "$ENV_FILE" ] && . "$ENV_FILE"
    
    UPS_IP=$(ip route 2>/dev/null | awk '/default/ {print $3; exit}')
    UPS_IF=$(ip route 2>/dev/null | awk '/default/ {print $5; exit}')
    
    echo "<font color=\"#00FF00\">[$(date '+%Y-%m-%d %H:%M:%S')] ── Starting Service ──</font>" >> "$LOG"
    write_log "Using Profile : $PROFILE_NAME"
    write_log "Upstream Interface: $UPS_IF ($UPS_IP)"
    write_log "Connecting to server"

    if [ "$TRANSPORT" = "TLS" ]; then
        stunnel /usr/share/passwall-ssh/stunnel.conf &
        echo $! > /var/run/passwall-stunnel.pid
    fi

    lua /usr/share/passwall-ssh/passwall-ssh-http.lua &
    echo $! > /var/run/passwall-http.pid

    /usr/share/passwall-ssh/watchdog.sh &
    echo $! > /var/run/passwall-ssh-watchdog.pid

}

start() {
    acquire_lock
    _start
    release_lock
}

stop() {
    acquire_lock
    _stop
    release_lock
}

restart() {
    acquire_lock
    _start
    release_lock
}

reload() {
    restart
}

boot() {
    MODE=$(uci -q get passwall-ssh.main.transport_mode 2>/dev/null)
    [ -z "$MODE" ] && MODE="ssh"

    if [ "$MODE" = "slowdns" ]; then
        ENABLE=$(uci -q get passwall-ssh-slowdns.SlowDNS.enabled 2>/dev/null)
    else
        ENABLE=$(uci -q get passwall-ssh.main.enabled 2>/dev/null)
    fi

    if [ "$ENABLE" = "1" ]; then
        start
    else
        echo "STOPPED" > "$STATE_FILE"
    fi
}
