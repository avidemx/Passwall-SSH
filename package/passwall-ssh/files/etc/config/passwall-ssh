
config sshtls 'main'
	option enabled '0'
	option selected_profile 'ilped_VPN'
	option dns_proto 'TCP'
	option dns_ip '1.1.1.1'

config profile 'ilped_VPN'
	option host 'xxxx.cloudfront.net'
	option host_port '443'
	option username 'xxxx'
	option password 'xxxx'
	option proxy 'adeva.kuncie.id'
	option sni 'xxxx.cloudfront.net'
	option payload 'GET / HTTP/1.1[crlf]Host: [host][crlf]Connection: Upgrade[crlf]User-Agent: [ua][crlf]Upgrade: websocket[crlf][crlf]'
	option proxy_port '443'
	option udpgw_port '7500'
	option transport 'TLS'
	option proxy_type 'HTTP'
	option tls_type 'TLS'

